<?xml version="1.0" encoding="UTF-8"?>
<workflow xmlns="http://www.wherescape.com/xml/Workflow" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wherescape.com/xml/Workflow workflow_4.xsd">
  <xml_version>4</xml_version>
  <name>Default Model Workflow</name>
  <type>Model</type>
  <button name="Add a Version">
    <button_desc>Create a new model version.</button_desc>
    <button_icon>Add-version-bg.png</button_icon>
    <button_type>WhereScape default</button_type>
    <button_value>Add a Version</button_value>
  </button>
  <button name="Document Models">
    <button_desc>Generate model and source system documentation, data validation documentation or documentation comparing source systems.</button_desc>
    <button_icon>doco.png</button_icon>
    <button_type>WhereScape default</button_type>
    <button_value>Document Models</button_value>
  </button>
  <button name="Compare Models">
    <button_desc>Compare the structure, business rules or profiling metrics for multiple models.</button_desc>
    <button_icon>compare-models.png</button_icon>
    <button_type>WhereScape default</button_type>
    <button_value>Compare Models</button_value>
  </button>
</workflow>
